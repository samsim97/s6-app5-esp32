{
  "C_Cpp.intelliSenseEngine": "default",
  "idf.extensionActivationMode": "always",
  "idf.openOcdConfigs": [
    "interface/ftdi/esp_ftdi.cfg",
    "target/esp32.cfg"
  ],
  "idf.portWin": "COM3",

  // EDIT ME — path to your local ESP-IDF install (the directory containing export.ps1).
  // Example: "C:\\esp\\v6.0.1\\esp-idf"
  "idf.currentSetup": "C:\\esp\\v6.0.2\\esp-idf",

  "idf.customExtraVars": {
    "IDF_TARGET": "esp32"
  },

  // EDIT ME — path to clangd.exe shipped with esp-clang. Version differs per IDF release.
  // Find yours under: <esp-idf-tools>\tools\esp-clang\<version>\esp-clang\bin\clangd.exe
  // Or delete this line and let the clangd VS Code extension auto-download a generic build.
  "clangd.path": "C:\\Espressif\\tools\\esp-clang\\esp-20.1.1_20250829\\esp-clang\\bin\\clangd.exe",
  "clangd.arguments": [
    "--background-index",
    "--query-driver=**",
    "--compile-commands-dir=${workspaceFolder}/build"
  ],

  "terminal.integrated.profiles.windows": {
    "ESP-IDF PowerShell": {
      "path": "powershell.exe",
      "args": [
        "-NoExit",
        "-ExecutionPolicy", "Bypass",
        "-Command",
        "& 'C:\\Users\\Neiz2\\.espressif\\python_env\\idf6.0_py3.11_env\\Scripts\\Activate.ps1'; & 'C:\\esp\\v6.0.1\\esp-idf\\export.ps1'"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "ESP-IDF PowerShell",
  "idf.flashType": "UART"
}
