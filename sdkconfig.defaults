# Project-wide defaults. Regenerate sdkconfig with `idf.py reconfigure`
# (or delete sdkconfig and rebuild) to pick up changes here.

# Disable C++ exceptions and RTTI — keeps binary size down and avoids
# pulling libsupc++ exception machinery.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# Custom partition table (1.75 MB factory app, fits in 2 MB configured flash)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="flash_partitions.csv"

# Bluetooth LE via NimBLE (BLE-only host stack, used by ble_scanner.cpp)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
